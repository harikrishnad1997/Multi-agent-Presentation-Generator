# Copy to .env and fill in, or export OPENAI_API_KEY in your shell.
# If OPENAI_API_KEY is not set, the app falls back to Muse's secure
# OpenAI connector helper (~/workspace/custom-connectors/custom.openai/bin/openai_chat.py),
# which injects the key at request time and never stores it in the repo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opik tracing (optional — strict no-op without a key):
# OPIK_API_KEY=<redacted>
# OPIK_WORKSPACE=harikrishnad1997
# OPIK_PROJECT_NAME=multi-agent-presentation-generator
